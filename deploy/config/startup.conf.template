config system global
    set hostname "@HOSTNAME@"
end

config system interface
    edit "port1"
        set alias "LAB-MGMT"
        set mode static
        set ip @MGMT_GUEST_IP@ @MGMT_MASK@
        set allowaccess ping https ssh
    next
    edit "port2"
        set alias "LAB-LAN"
        set mode static
        set ip @LAN_GUEST_IP@ @LAN_MASK@
        set allowaccess ping
    next
    edit "port3"
        set alias "LAB-DMZ"
        set mode static
        set ip @DMZ_GUEST_IP@ @DMZ_MASK@
        set allowaccess ping
    next
end

config firewall address
    edit "LAB-LAN-NET"
        set subnet @LAN_NETWORK@ @LAN_MASK@
    next
    edit "LAB-DMZ-NET"
        set subnet @DMZ_NETWORK@ @DMZ_MASK@
    next
end

config firewall service custom
    edit "LAB-HTTP-8080"
        set tcp-portrange 8080
    next
end

config firewall policy
    edit 1
        set name "LAB-LAN-DMZ-HTTP"
        set srcintf "port2"
        set dstintf "port3"
        set srcaddr "LAB-LAN-NET"
        set dstaddr "LAB-DMZ-NET"
        set action accept
        set schedule "always"
        set service "HTTP"
        set logtraffic all
        set nat disable
    next
    edit 2
        set name "LAB-LAN-DMZ-DENY-8080"
        set srcintf "port2"
        set dstintf "port3"
        set srcaddr "LAB-LAN-NET"
        set dstaddr "LAB-DMZ-NET"
        set action deny
        set schedule "always"
        set service "LAB-HTTP-8080"
        set logtraffic all
    next
end

config log memory setting
    set status enable
end
