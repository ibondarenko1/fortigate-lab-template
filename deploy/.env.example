# Copy this file to .env and adjust only the values that belong to this lab.
# The file is ignored by Git. Do not put a license, firmware path, or password here.
COMPOSE_PROJECT_NAME=fortigate_lab_template
FORTIGATE_IMAGE=local/fortigate-lab:7.6.8
FORTIGATE_VERSION=7.6.8
# scripts/start.sh fills this once for a fresh instance. Never reuse it across clones.
FORTIGATE_UUID=
LAB_HOSTNAME=fortigate-lab

# The 10.231.30/31/32 ranges are intentionally separate from the existing OMEN lab.
# The adapter's FortiOS guest uses .1, the container-side link uses .2, and
# Docker's bridge gateway is .254. Fixed lab nodes use .10.
LAB_MGMT_CIDR=10.231.30.0/24
LAB_MGMT_GUEST_IP=10.231.30.2
LAB_MGMT_LINK_IP=10.231.30.2
LAB_MGMT_BRIDGE_GATEWAY=10.231.30.254

LAB_LAN_CIDR=10.231.31.0/24
LAB_LAN_GUEST_IP=10.231.31.1
LAB_LAN_LINK_IP=10.231.31.2
LAB_LAN_NODE=10.231.31.10
LAB_LAN_BRIDGE_GATEWAY=10.231.31.254

LAB_DMZ_CIDR=10.231.32.0/24
LAB_DMZ_GUEST_IP=10.231.32.1
LAB_DMZ_LINK_IP=10.231.32.2
LAB_DMZ_NODE=10.231.32.10
LAB_DMZ_BRIDGE_GATEWAY=10.231.32.254

# All appliance ports are bound to loopback only.
LAB_GUI_PORT=18843
LAB_HTTP_PORT=18880
LAB_SSH_PORT=18222
LAB_SERIAL_PORT=18500
